# OpenViking Admin 数据库迁移配置示例。
# 使用方式：
# 1. Linux/macOS: cp scripts/db-migrate.env.example scripts/db-migrate.local.env
# 2. Windows PowerShell: 参考本文件创建 scripts/db-migrate.local.ps1
# 3. 填写真实值后运行迁移脚本。
#
# 注意：不要提交 db-migrate.local.env 或 db-migrate.local.ps1。

OPENVIKING_DB_HOST=postgres.example.internal
OPENVIKING_DB_PORT=5432
OPENVIKING_DB_USER=openviking_admin
OPENVIKING_DB_PASS=replace_with_real_password
OPENVIKING_DB_NAME=openviking_admin
OPENVIKING_DB_MAINTENANCE_DB=postgres

# local 使用本机 pnpm 执行迁移；docker-image 使用后端 Docker 镜像执行迁移。
OPENVIKING_MIGRATION_RUNNER=local
OPENVIKING_BUILD_SERVER_IMAGE=false
OPENVIKING_SERVER_IMAGE_NAME=openviking-admin-server:migration
OPENVIKING_POSTGRES_CLIENT_IMAGE=postgres:16-alpine

OPENVIKING_SHOW_MIGRATION_STATUS=true
OPENVIKING_ENSURE_PLATFORM_ADMIN=true
OPENVIKING_PLATFORM_ADMIN_USERNAME=admin
